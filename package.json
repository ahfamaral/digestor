{
  "name": "digestor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "pnpm -r --filter '!@digestor/worker' test",
    "test:worker": "docker compose run --rm worker pnpm --filter @digestor/worker test",
    "test:all": "pnpm test && pnpm test:worker",
    "db:migrate": "pnpm --filter @digestor/core db:migrate",
    "typecheck": "pnpm -r typecheck",
    "monitor:videos:prod": "bash scripts/monitor-videos-prod.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
