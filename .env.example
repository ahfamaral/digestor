# Host values (the web app and host-side tooling). Compose overrides
# DATABASE_URL / TEST_DATABASE_URL / DATA_DIR for containers (host `postgres`, /data).
DATABASE_URL=postgres://digestor:digestor@localhost:5432/digestor
TEST_DATABASE_URL=postgres://digestor:digestor@localhost:5432/digestor_test
DATA_DIR=./data

ANTHROPIC_API_KEY=
ASSEMBLYAI_API_KEY=

# LLM provider: anthropic (default, uses ANTHROPIC_API_KEY) or openrouter (uses OPENROUTER_API_KEY).
# Transcription always uses AssemblyAI. Each analysis version records the models it used.
LLM_PROVIDER=
OPENROUTER_API_KEY=
# OpenRouter model ids (https://openrouter.ai/models); blank = anthropic/claude-sonnet-5.5 and anthropic/claude-haiku-5.5
OPENROUTER_MODEL_REASONING=
OPENROUTER_MODEL_FAST=

# Password gate; leave empty to disable
APP_PASSWORD=
MAX_UPLOAD_GB=5
VIDEO_RETENTION_DAYS=14
# YouTube cookies for server downloads (see docs/deploy.md): put the file in ./secrets/ and set
# YTDLP_COOKIES_FILE=/secrets/youtube-cookies.txt (the path inside the worker container). Blank = no cookies.
YTDLP_COOKIES_FILE=
# Monitor video evidence: the worker matches one plenary's YouTube captions every 5 minutes only when this is exactly
# "true". Blank or missing = off. Leave it off on a server: YouTube blocks server IPs (see docs/deploy.md).
MONITOR_VIDEO_ENABLED=

# Optional: key of the Bundestag DIP API (https://dip.bundestag.de/über-dip/hilfe/api). Only used as a fallback when the open-data
# page that lists the Plenarprotokoll XML files can't be read. Blank = no fallback: a list that can't be read then fails the fetch once the job's retries are used up (it only keeps waiting while the sitting is still inside the house's publish window).
BUNDESTAG_DIP_API_KEY=

# Required for US House and Senate speaker names: a free api.data.gov key (https://api.data.gov/signup/) for the GovInfo Congressional Record.
# Blank = a linked US record fails with "API_DATA_GOV_KEY is not set on the server." (no retry).
API_DATA_GOV_KEY=

# Production only (used by Caddy)
PUBLIC_HOSTNAME=
# Production only: the Postgres password (compose refuses to start without it). Use letters and digits only,
# for example `openssl rand -hex 24`: it is placed inside DATABASE_URL.
POSTGRES_PASSWORD=
