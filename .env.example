# Host values (the web app and host-side tooling). Compose overrides
# DATABASE_URL / TEST_DATABASE_URL / DATA_DIR for containers (host `postgres`, /data).
DATABASE_URL=postgres://digestor:digestor@localhost:5432/digestor
TEST_DATABASE_URL=postgres://digestor:digestor@localhost:5432/digestor_test
DATA_DIR=./data

ANTHROPIC_API_KEY=
ASSEMBLYAI_API_KEY=

# Password gate; leave empty to disable
APP_PASSWORD=
MAX_UPLOAD_GB=5
VIDEO_RETENTION_DAYS=14

# Production only (used by Caddy)
PUBLIC_HOSTNAME=
