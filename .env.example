# Host values (the web app and host-side tooling). Compose overrides
# DATABASE_URL / TEST_DATABASE_URL / DATA_DIR for containers (host `postgres`, /data).
DATABASE_URL=postgres://digestor:digestor@localhost:5432/digestor
TEST_DATABASE_URL=postgres://digestor:digestor@localhost:5432/digestor_test
DATA_DIR=./data

ANTHROPIC_API_KEY=
ASSEMBLYAI_API_KEY=

# LLM provider: anthropic (default, uses ANTHROPIC_API_KEY) or openrouter (uses OPENROUTER_API_KEY).
# Transcription always uses AssemblyAI. Each analysis version records the models it used.
LLM_PROVIDER=
OPENROUTER_API_KEY=
# OpenRouter model ids (https://openrouter.ai/models); blank = anthropic/claude-sonnet-5.5 and anthropic/claude-haiku-5.5
OPENROUTER_MODEL_REASONING=
OPENROUTER_MODEL_FAST=

# Password gate; leave empty to disable
APP_PASSWORD=
MAX_UPLOAD_GB=5
VIDEO_RETENTION_DAYS=14
# YouTube cookies for server downloads (see docs/deploy.md): put the file in ./secrets/ and set
# YTDLP_COOKIES_FILE=/secrets/youtube-cookies.txt (the path inside the worker container). Blank = no cookies.
YTDLP_COOKIES_FILE=

# Production only (used by Caddy)
PUBLIC_HOSTNAME=
